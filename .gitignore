# Windows and OneDrive noise
Thumbs.db
desktop.ini
*.lnk

# Temp files the installer's atomic writer can leave behind if a run is killed
*.tmp
*.old

# The shareable plain-text copy of the installer stays local. The repository is the canonical
# source now, and a second copy would only drift out of sync.
Install-VSCodeCopilotCouncil-v5.txt

# Scratch workspaces from running the installer by hand. The Pester suite writes to the system
# temp directory instead, so nothing here is ever a test artifact.
/temp-*/
testResults.xml
